# ==============================================================================
# Institutional Multi-School Trading Signals Bot — Environment Configuration
# ==============================================================================

# --- Telegram Bot Settings (Required) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Market Universe & Scanning ---
ENABLE_CRYPTO=true
ENABLE_GOLD=true
TOP_CRYPTO_COUNT=20
OHLCV_LIMIT=300
SCAN_INTERVAL_SECONDS=300
MONITOR_INTERVAL_SECONDS=30

# --- Gold (XAUUSD) Data Source ---
# Options: yfinance (default, no key required) | twelvedata
GOLD_DATA_PROVIDER=yfinance
GOLD_YFINANCE_SYMBOL=GC=F
GOLD_TWELVEDATA_SYMBOL=XAU/USD
TWELVEDATA_API_KEY=

# Gold Liquidity Session Filter (UTC hours: 07:00 - 21:00 covers London + New York)
GOLD_SESSION_START_UTC=7
GOLD_SESSION_END_UTC=21

# --- Confluence & Risk Thresholds ---
MIN_CONFLUENCE_SCORE=75
MIN_RR_TP2=2.0

# --- Optional Final AI Confirmation Layer (Claude or OpenAI) ---
# Leave AI_API_KEY empty to automatically use the built-in smart Arabic rationale engine
AI_API_KEY=
# Options: auto | anthropic | openai
AI_PROVIDER=auto
# Optional model override (defaults: claude-sonnet-4-6 / gpt-4o-mini)
AI_MODEL=

# --- Persistence, Reporting & Logging ---
DB_PATH=trades.db
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
DAILY_REPORT_HOUR_UTC=20
WEEKLY_REPORT_DAY_UTC=6

# --- Rate Limit & Retry Tuning ---
CCXT_PAUSE_SECONDS=0.25
MAX_RETRIES=3
RETRY_BACKOFF_BASE=1.5

# --- Trade lifecycle & risk guards (new) ---
# Hours to wait before a new signal on a symbol that just traded
SIGNAL_COOLDOWN_HOURS=4
# Pending (unfilled) signals are cancelled after N hours
PENDING_EXPIRY_HOURS=12
# Max simultaneous PENDING+ACTIVE trades (limits correlated exposure)
MAX_OPEN_TRADES=6
# Ignore the still-forming candle so signals never repaint
DROP_FORMING_CANDLE=true
SEND_STARTUP_MESSAGE=true

# --- Web dashboard / PWA (new) ---
API_ENABLED=true
# 127.0.0.1 = this machine only. Use 0.0.0.0 on a server (then API_TOKEN is REQUIRED).
API_HOST=127.0.0.1
API_PORT=8080
# Long random string, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=
